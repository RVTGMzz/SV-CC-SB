+++ b/BUILD_ALPHA11_TEST.bat
@@ -0,0 +1,117 @@
+@echo off
+chcp 65001 >nul
+setlocal EnableExtensions EnableDelayedExpansion
+cd /d "%~dp0"
+title Cardcha! v0.3.0-alpha.11 - Build TEST
+
+set "ROOT=%~dp0"
+set "PROJECT=%ROOT%src\Cardcha\Cardcha.csproj"
+set "RELEASES=%ROOT%_releases"
+set "READY=%ROOT%_READY_TO_TEST"
+set "LOG=%ROOT%build-alpha11-log.txt"
+set "EXPECTED=Cardcha! v0.3.0-alpha.11 BINDER INPUT + FULL FLASH"
+set "GAME_PATH="
+
+for %%G in (
+  "E:\SteamLibrary\steamapps\common\Stardew Valley"
+  "D:\SteamLibrary\steamapps\common\Stardew Valley"
+  "C:\Program Files (x86)\Steam\steamapps\common\Stardew Valley"
+  "C:\Program Files\Steam\steamapps\common\Stardew Valley"
+) do (
+  if not defined GAME_PATH if exist "%%~G\Stardew Valley.dll" set "GAME_PATH=%%~G"
+)
+
+cls
+echo ============================================================
+echo   CARDCHA! v0.3.0-alpha.11 - BINDER INPUT + FULL FLASH
+echo ============================================================
+echo.
+echo Builder FULL: khong can clone repo, khong tu cai mod.
+echo Sau khi build thanh cong, ZIP test nam trong _READY_TO_TEST.
+echo.
+
+if not exist "%PROJECT%" goto :NO_PROJECT
+where dotnet >nul 2>&1
+if errorlevel 1 goto :NO_SDK
+
+if not defined GAME_PATH (
+  echo Khong tim thay Stardew Valley tu dong.
+  set /p "GAME_PATH=Nhap duong dan thu muc Stardew Valley: "
+)
+if not exist "%GAME_PATH%\Stardew Valley.dll" goto :NO_GAME
+if not exist "%GAME_PATH%\StardewModdingAPI.dll" goto :NO_GAME
+
+if exist "%RELEASES%" rmdir /s /q "%RELEASES%"
+if exist "%READY%" rmdir /s /q "%READY%"
+mkdir "%RELEASES%" >nul 2>&1
+mkdir "%READY%" >nul 2>&1
+
+>"%LOG%" echo ===== CARDCHA alpha.11 BUILD LOG =====
+>>"%LOG%" echo Expected: %EXPECTED%
+>>"%LOG%" echo GamePath: %GAME_PATH%
+>>"%LOG%" echo Date: %date% %time%
+>>"%LOG%" echo.
+
+echo [1/2] Restore...
+dotnet restore "%PROJECT%" -p:GamePath="%GAME_PATH%" >>"%LOG%" 2>&1
+if errorlevel 1 goto :BUILD_FAIL
+
+echo [2/2] Build...
+dotnet build "%PROJECT%" -c Release --no-restore -p:EnableModDeploy=false -p:EnableModZip=true -p:GamePath="%GAME_PATH%" -p:ModZipPath="%RELEASES%" >>"%LOG%" 2>&1
+if errorlevel 1 goto :BUILD_FAIL
+
+set "BUILT_ZIP="
+for /f "delims=" %%Z in ('dir /b /a-d /o-d "%RELEASES%\*.zip" 2^>nul') do (
+  if not defined BUILT_ZIP set "BUILT_ZIP=%RELEASES%\%%Z"
+)
+if not defined BUILT_ZIP goto :NO_ZIP
+
+copy /y "!BUILT_ZIP!" "%READY%\Cardcha_v0.3.0-alpha.11_BinderInputFullFlash_TEST.zip" >nul
+
+echo.
+echo ============================================================
+echo   BUILD PASSED
+echo ============================================================
+echo.
+echo File test:
+echo %READY%\Cardcha_v0.3.0-alpha.11_BinderInputFullFlash_TEST.zip
+echo.
+echo KHONG co mod nao duoc tu dong cai vao Mods.
+echo Giai nen/copy ZIP test vao Mods nhu binh thuong de test.
+echo.
+pause
+exit /b 0
+
+:NO_PROJECT
+echo [ERROR] Khong tim thay src\Cardcha\Cardcha.csproj.
+pause
+exit /b 10
+
+:NO_SDK
+echo [ERROR] Khong tim thay .NET SDK. Cai .NET SDK phu hop roi chay lai.
+pause
+exit /b 20
+
+:NO_GAME
+echo [ERROR] Khong tim thay Stardew Valley.dll + StardewModdingAPI.dll tai:
+echo %GAME_PATH%
+pause
+exit /b 30
+
+:NO_ZIP
+echo [ERROR] Build xong nhung khong tim thay ZIP trong _releases.
+echo Gui %LOG% cho ChatGPT.
+pause
+exit /b 40
+
+:BUILD_FAIL
+echo.
+echo ============================================================
+echo   BUILD FAILED
+echo ============================================================
+echo Gui file nay cho ChatGPT:
+echo %LOG%
+echo.
+start "" notepad "%LOG%"
+pause
+exit /b 50
